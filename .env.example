DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/banku_main
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
PORT=3000
NODE_ENV=development
BANK_SIMULATOR_PORT=4001
BANK_SIMULATOR_URL=http://127.0.0.1:4001
# Optional: success, reject, delay, http_500, duplicate_webhook, out_of_order
# BANK_SIMULATOR_MODE=success

# Use six distinct random values in local .env. Never commit real keys.
NATIONAL_BANK_API_KEY=replace_with_national_bank_api_key
NATIONAL_BANK_WEBHOOK_SECRET=replace_with_national_bank_webhook_secret
STATE_BANK_API_KEY=replace_with_state_bank_api_key
STATE_BANK_WEBHOOK_SECRET=replace_with_state_bank_webhook_secret
HOLY_BANK_API_KEY=replace_with_holy_bank_api_key
HOLY_BANK_WEBHOOK_SECRET=replace_with_holy_bank_webhook_secret
